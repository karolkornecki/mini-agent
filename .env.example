# Required: your API key from OpenRouter.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: model identifier on OpenRouter (shown with the application default).
MODEL=qwen/qwen3-coder

# Optional: positive integer context capacity in tokens, used for context monitoring.
MODEL_CONTEXT_WINDOW=128000

# Optional: Langfuse tracing. Set to true and fill in the settings below to enable.
LANGFUSE_TRACING_ENABLED=false
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
