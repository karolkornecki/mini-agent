# Required: your API key from OpenRouter.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: model identifier on OpenRouter (shown with the application default).
MODEL=qwen/qwen3-coder

# Optional: positive integer context capacity in tokens, used for context monitoring.
MODEL_CONTEXT_WINDOW=128000

# Optional: generated-token limit and context space reserved for model output.
# Must be positive and smaller than MODEL_CONTEXT_WINDOW.
MODEL_OUTPUT_RESERVE=8192

# Optional: integer warning thresholds as percentages of input capacity
# (MODEL_CONTEXT_WINDOW - MODEL_OUTPUT_RESERVE). Require 0 < warning < critical <= 100.
CONTEXT_WARNING_PERCENT=80
CONTEXT_CRITICAL_PERCENT=95

# Optional: maximum characters per tool result sent to the model, including the
# truncation marker. Minimum 24.
MAX_TOOL_OUTPUT_CHARS=16000

# Optional: Langfuse tracing. Set to true and fill in the settings below to enable.
LANGFUSE_TRACING_ENABLED=false
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
